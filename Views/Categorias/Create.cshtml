@model Categoria
@{
    ViewData["Title"] = "Nova categoria";
}
<section class="painel painel-estreito">
    <form method="post" class="formulario">
        @await Html.PartialAsync("_Validacao")
        <div class="campo">
            <label asp-for="Nome">Nome</label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome" class="erro-campo"></span>
        </div>
        <div class="acoes">
            <button type="submit" class="botao">Salvar</button>
            <a class="botao botao-claro" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>
