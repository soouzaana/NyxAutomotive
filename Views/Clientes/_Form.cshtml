@model Cliente

<form method="post" class="formulario">
    @await Html.PartialAsync("_Validacao")

    <div class="campo">
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome" class="erro-campo"></span>
    </div>
    <div class="linha-campos">
        <div class="campo">
            <label asp-for="Cpf">CPF</label>
            <input asp-for="Cpf" placeholder="000.000.000-00" maxlength="14" />
            <span asp-validation-for="Cpf" class="erro-campo"></span>
        </div>
        <div class="campo">
            <label asp-for="Telefone">Telefone</label>
            <input asp-for="Telefone" placeholder="(92) 90000-0000" />
            <span asp-validation-for="Telefone" class="erro-campo"></span>
        </div>
    </div>
    <div class="campo">
        <label asp-for="Email">E-mail</label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="erro-campo"></span>
    </div>

    <div class="acoes">
        <button type="submit" class="botao">Salvar</button>
        <a class="botao botao-claro" asp-action="Index">Cancelar</a>
    </div>
</form>
