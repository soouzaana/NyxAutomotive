@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="barra">
    <span class="intro">@Model.Count cliente(s) cadastrado(s)</span>
    <a class="botao" asp-action="Create">Novo cliente</a>
</div>

<div class="tabela-area">
    <table class="tabela">
        <thead>
            <tr><th>ID</th><th>Nome</th><th>CPF</th><th>Telefone</th><th>E-mail</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nome</td>
                    <td>@c.Cpf</td>
                    <td>@c.Telefone</td>
                    <td>@c.Email</td>
                    <td class="acoes-linha">
                        <a asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirmar="Excluir o cliente @c.Nome?">
                            <button type="submit" class="link-perigo">Excluir</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
